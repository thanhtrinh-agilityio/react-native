{
  "cli": {
    "version": ">= 16.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "channel": "preview",
      "environment": "preview",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "cache": {
        "key": "preview-${hash:package-lock.json}"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "developmentClient": false,
      "autoIncrement": true,
      "distribution": "internal",
      "cache": {
        "key": "production-${hash:package-lock.json}"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
